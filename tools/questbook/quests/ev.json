    {
      "key": "gg.ev.hev",
      "title": "Hazardous Environment Armor",
      "tier": "EV",
      "desc": "The HEV suit is built for places that want you dead. Worn as a full set, it protects against biological hazards, pollution gas and radiation, and it adds heat, cold and electrical protection while the chestplate holds a charge.\n\nEach piece is an EV Assembler recipe of Epoxid Fiber Reinforced and titanium plates and EV circuits. The chestplate is the electric part, charged in an EV charger or battery buffer. The quest wants the chestplate, but wear all four pieces: GT only counts the protection when the whole set has it.\n\n[note]Check NEI for the circuit number on each piece.[/note]",
      "pre": [
        "gg.ev.t3_armor"
      ],
      "tasks": [
        {
          "type": "optional_retrieval",
          "items": [
            {
              "id": "gregtech:gt.metaitem.01",
              "count": 4,
              "damage": 17028,
              "ore": "plateTitanium"
            }
          ]
        },
        {
          "type": "retrieval",
          "items": [
